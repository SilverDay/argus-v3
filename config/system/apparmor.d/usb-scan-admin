# USB Scan Station AppArmor profile: admin web (usbscan-web, gunicorn)
# Owner decision (Phase 11): shipped in COMPLAIN mode. Attached by name through the unit's
# AppArmorProfile= (all services share the Python interpreter, so path attachment cannot
# separate them). Tune with aa-logprof against the acceptance tests on the Pi, then promote:
#   sudo /opt/usb-scan/scripts/harden.sh --apparmor-enforce
abi <abi/4.0>,
include <tunables/global>

profile usb-scan-admin flags=(complain) {
  include <abstractions/base>
  include <abstractions/python>

  /opt/usb-scan/** r,
  /opt/usb-scan/.venv/bin/python* ix,
  /usr/bin/python3* ix,
  /usr/lib/python3*/** mr,
  /etc/usb-scan/scan_station.yaml r,
  @{PROC}/@{pid}/{stat,status,mountinfo,fd/} r,
  /run/systemd/notify w,
  include <abstractions/nameservice>
  include <abstractions/openssl>
  include <abstractions/ssl_certs>
  /opt/usb-scan/.venv/bin/gunicorn ix,
  # OIDC client secret / local accounts via systemd credentials; IdP CA bundles
  /run/credentials/usb-scan-admin.service/ r,
  /run/credentials/usb-scan-admin.service/* r,
  /etc/usb-scan/pki/ r,
  /etc/usb-scan/pki/** r,
  /var/lib/usb-scan/web/ rw,
  /var/lib/usb-scan/web/** rwk,
  /run/usb-scan/events.sock rw,
  /sys/class/thermal/thermal_zone*/temp r,
  /tmp/** rwk,
  network unix stream,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  deny /run/usb-scan/mounts/** rwx,
  deny /var/lib/usb-scan/quarantine/** rwx,
}
