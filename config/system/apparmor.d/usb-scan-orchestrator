# USB Scan Station AppArmor profile: orchestrator (usbscan)
# Owner decision (Phase 11): shipped in COMPLAIN mode. Attached by name through the unit's
# AppArmorProfile= (all services share the Python interpreter, so path attachment cannot
# separate them). Tune with aa-logprof against the acceptance tests on the Pi, then promote:
#   sudo /opt/usb-scan/scripts/harden.sh --apparmor-enforce
abi <abi/4.0>,
include <tunables/global>

profile usb-scan-orchestrator flags=(complain) {
  include <abstractions/base>
  include <abstractions/python>

  /opt/usb-scan/** r,
  /opt/usb-scan/.venv/bin/python* ix,
  /usr/bin/python3* ix,
  /usr/lib/python3*/** mr,
  /etc/usb-scan/scan_station.yaml r,
  @{PROC}/@{pid}/{stat,status,mountinfo,fd/} r,
  /run/systemd/notify w,
  include <abstractions/nameservice>
  include <abstractions/openssl>
  include <abstractions/ssl_certs>
  /etc/usb-scan/secrets/{broker-hmac.key,operator_pin.hash} r,
  /etc/usb-scan/secrets/vt_api_key r,
  /var/lib/usb-scan/orchestrator/ rw,
  /var/lib/usb-scan/orchestrator/** rwk,
  /var/lib/usb-scan/quarantine/ rw,
  /var/lib/usb-scan/quarantine/** rw,
  /run/usb-scan/ r,
  /run/usb-scan/*.sock rw,
  /run/usb-scan/mounts/** r,
  /run/clamav/clamd.ctl rw,
  /var/log/usb-scan/*.jsonl rw,
  /sys/** r,
  @{PROC}/sys/kernel/random/boot_id r,
  /usr/bin/minisign ix,
  network unix stream,
  network netlink raw,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
}
