# USB Scan Station AppArmor profile: events/audit service (usbscan-events)
# Owner decision (Phase 11): shipped in COMPLAIN mode. Attached by name through the unit's
# AppArmorProfile= (all services share the Python interpreter, so path attachment cannot
# separate them). Tune with aa-logprof against the acceptance tests on the Pi, then promote:
#   sudo /opt/usb-scan/scripts/harden.sh --apparmor-enforce
abi <abi/4.0>,
include <tunables/global>

profile usb-scan-events flags=(complain) {
  include <abstractions/base>
  include <abstractions/python>

  /opt/usb-scan/** r,
  /opt/usb-scan/.venv/bin/python* ix,
  /usr/bin/python3* ix,
  /usr/lib/python3*/** mr,
  /etc/usb-scan/scan_station.yaml r,
  @{PROC}/@{pid}/{stat,status,mountinfo,fd/} r,
  /run/systemd/notify w,
  include <abstractions/nameservice>
  include <abstractions/openssl>
  include <abstractions/ssl_certs>
  /etc/usb-scan/secrets/{events-checkpoint,pseudonymization,station-mtls}.key r,
  # mTLS station certificate (scripts/station-cert.sh), site CA bundles, systemd credentials
  # (alert/forwarding tokens via credential: references)
  /etc/usb-scan/station-mtls.crt r,
  /etc/usb-scan/pki/ r,
  /etc/usb-scan/pki/** r,
  /run/credentials/usb-scan-events.service/ r,
  /run/credentials/usb-scan-events.service/* r,
  /var/lib/usb-scan/events/ rw,
  /var/lib/usb-scan/events/** rwk,
  /run/usb-scan/events.sock rw,
  network unix stream,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
}
