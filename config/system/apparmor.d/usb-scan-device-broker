# USB Scan Station AppArmor profile: device broker (root, CAP_SYS_ADMIN+CAP_CHOWN)
# Owner decision (Phase 11): shipped in COMPLAIN mode. Attached by name through the unit's
# AppArmorProfile= (all services share the Python interpreter, so path attachment cannot
# separate them). Tune with aa-logprof against the acceptance tests on the Pi, then promote:
#   sudo /opt/usb-scan/scripts/harden.sh --apparmor-enforce
abi <abi/4.0>,
include <tunables/global>

profile usb-scan-device-broker flags=(complain) {
  include <abstractions/base>
  include <abstractions/python>

  /opt/usb-scan/** r,
  /opt/usb-scan/.venv/bin/python* ix,
  /usr/bin/python3* ix,
  /usr/lib/python3*/** mr,
  /etc/usb-scan/scan_station.yaml r,
  @{PROC}/@{pid}/{stat,status,mountinfo,fd/} r,
  /run/systemd/notify w,
  capability sys_admin,
  capability chown,
  capability setpcap,
  capability dac_override,
  /etc/usb-scan/secrets/broker-hmac.key r,
  /run/usb-scan/ rw,
  /run/usb-scan/broker.sock rw,
  /run/usb-scan/mounts/ rw,
  /run/usb-scan/mounts/** rw,
  /var/log/usb-scan/broker-audit.log rwk,
  /sys/** r,
  /dev/sd* r,
  /dev/loop* r,
  /dev/fuse rw,
  /usr/bin/mount ix,
  /usr/bin/umount ix,
  /usr/sbin/blkid ix,
  /usr/sbin/blockdev ix,
  /usr/bin/ntfs-3g ix,
  mount -> /run/usb-scan/mounts/**,
  umount /run/usb-scan/mounts/**,
  network unix stream,
  network netlink raw,
}
